# =========================
# CricketPulse Environment
# =========================

# Groq API
GROQ_API_KEY=your_groq_api_key_here

# Redis
REDIS_URL=redis://:your_redis_password@your_server_ip:6379
REDIS_CHANNEL=match:events

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://username:password@host:5432/database_name?ssl=disable